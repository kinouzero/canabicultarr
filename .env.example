# Shared Docker Compose and Laravel configuration. Never commit real credentials.
# Copy this file to .env, edit the values, then run sh scripts/bootstrap.sh.
# Bootstrap links backend/.env to this file for local Laravel commands.
# Nonempty connection values lock the corresponding UI fields, including false and 0.
# Leave optional connection variables commented to manage them in the UI.
# Required: supply a value for the indicated deployment/feature.
# Optional: may be omitted; the comment states the actual fallback. Preset values can differ.
# A blank assignment is not the same as an omitted/commented variable.

# Application
# Optional: application name; framework fallback is Laravel. Recommended preset: Canabicultarr.
APP_NAME=Canabicultarr
# Optional: the default is the versioned GHCR image in compose.yaml.
APP_IMAGE=
# Optional: default production.
APP_ENV=production
# Required at runtime: bootstrap generates it when missing. Preserve the original key.
APP_KEY=
# Optional: comma-separated previous application keys retained after a key rotation.
# APP_PREVIOUS_KEYS=
# Optional: default false. Keep false in production.
APP_DEBUG=false
# Optional: default 8420, mapped to container port 8420.
APP_PORT=8420
# Optional: explicit trusted TLS proxy IPs or CIDRs, comma-separated. Leave blank for direct HTTPS.
APP_TRUSTED_PROXIES=
# Required for your public deployment URL; local Compose fallback uses localhost and APP_PORT.
APP_URL=http://localhost:${APP_PORT}
# Optional: default en.
APP_LOCALE=en
# Optional: default en.
APP_FALLBACK_LOCALE=en
# Optional: default en_US; used for generated test/demo data.
APP_FAKER_LOCALE=en_US

# Runtime and logging
# Optional: default file.
APP_MAINTENANCE_DRIVER=file
# Optional: default database; only used with the cache maintenance driver.
# APP_MAINTENANCE_STORE=database
# Optional: image default true; migrate before services start. Set false for a manual migration rollout.
# APP_AUTO_MIGRATE=true
# Worker overrides: uncomment and set false to disable a worker.
# Optional: image default true.
# APP_QUEUE_WORKER_ENABLED=true
# Optional: image default true.
# APP_SCHEDULER_ENABLED=true
# Optional: image default true; MQTT itself remains opt-in.
# APP_MQTT_WORKER_ENABLED=true
# Optional: framework default stack; stderr is the recommended container preset.
LOG_CHANNEL=stderr
# Optional: default single; only used by the stack log channel.
LOG_STACK=single
# Optional: default null (no deprecation log channel).
LOG_DEPRECATIONS_CHANNEL=null
# Optional: framework default debug; info is the recommended production preset.
LOG_LEVEL=info

# Database
# These settings are shared by Compose and Laravel.
# Required for bundled PostgreSQL: pgsql. Omission would select SQLite.
DB_CONNECTION=pgsql
# Required for bundled PostgreSQL: postgres. Framework fallback is 127.0.0.1.
DB_HOST=postgres
# Optional: default 5432 for PostgreSQL.
DB_PORT=5432
# Required for bundled PostgreSQL: match the database name. Framework fallback is laravel.
DB_DATABASE=canabicultarr
# Required for bundled PostgreSQL: match the database user. Framework fallback is root.
DB_USERNAME=canabicultarr
# Required: set a strong PostgreSQL password; Compose rejects an empty/missing value.
DB_PASSWORD=replace-with-strong-password
# Optional: full database connection URL overrides individual Laravel DB settings.
# DB_URL=
# Optional: PostgreSQL TLS policy, default prefer.
# DB_SSLMODE=prefer

# Scheduled instance backups (optional, PostgreSQL)
# Optional: default false. The Artisan backup:create command can also run on demand.
# BACKUP_ENABLED=true
# Required to create a backup: public key from age-keygen. Keep the private key off the server.
# BACKUP_RECIPIENT=
# Optional: daily (default) or weekly.
# BACKUP_FREQUENCY=daily
# Optional: weekly day 0 (Sunday) through 6, default 0.
# BACKUP_DAY=0
# Optional: 24-hour time HH:MM, default 02:00.
# BACKUP_TIME=02:00
# Optional: IANA timezone, default UTC.
# BACKUP_TIMEZONE=UTC
# Optional: number of successful archives kept in the destination, default 14.
# BACKUP_KEEP=14
# Optional: writable absolute path, default /var/www/html/storage/app/backups.
# BACKUP_PATH=/backups
# Optional: path to an additional deployment dotenv file mounted read-only in the app.
# BACKUP_CONFIG_FILE=/run/canabicultarr/instance.env

# Sessions and account security
# Unused by the current Argon2id password driver; this variable can be omitted.
BCRYPT_ROUNDS=12
# Optional: default database.
SESSION_DRIVER=database
# Optional: default 120 minutes.
SESSION_LIFETIME=120
# Optional: default false.
SESSION_ENCRYPT=false
# Optional: default /.
SESSION_PATH=/
# Optional: default null (host-only cookie).
SESSION_DOMAIN=null
# Optional: follows request security when omitted; set true for an HTTPS-only deployment.
# SESSION_SECURE_COOKIE=true
# Password recovery is opt-in and requires email plus a trusted public root URL.
# Optional: default false. Enabling recovery requires working email delivery.
PASSWORD_RECOVERY_ENABLED=false
# Required when password recovery is enabled: trusted browser-facing root URL; no URL by default.
PASSWORD_RECOVERY_URL="${APP_URL}/"

# Cache, queue and Redis
# Optional: default redis.
CACHE_STORE=redis
# Optional: default redis.
QUEUE_CONNECTION=redis
# Optional: automatically derived from APP_NAME.
# CACHE_PREFIX=canabicultarr-
# Optional: default phpredis.
REDIS_CLIENT=phpredis
# Optional Redis-compatible implementation and existing volume overrides.
# Optional: Compose default redis:8.4.4-alpine.
# REDIS_IMAGE=redis:8.4.4-alpine
# Optional: derived from the Compose project name; override to reuse an existing volume.
# REDIS_VOLUME_NAME=canabicultarr_redis_data
# Required for bundled Redis: redis. Framework fallback is 127.0.0.1.
REDIS_HOST=redis
# Optional: default 6379.
REDIS_PORT=6379
# Optional: no password by default; required if your Redis server enforces authentication.
REDIS_PASSWORD=null
# REDIS_SCHEME is not consumed by the current configuration.

# File storage (local or S3-compatible)
# Document/photo storage: documents (local) or documents_s3.
# Optional: default documents (private local files); documents_s3 selects configured S3 storage.
# DOCUMENTS_DISK=documents
# Generic S3 settings; the optional bundled server uses the same AWS credentials.
# Required for a custom S3 service such as RustFS; omit for the standard AWS endpoint.
# AWS_ENDPOINT=http://rustfs:9000
# Optional: default us-east-1 for document storage; match your provider when different.
# AWS_DEFAULT_REGION=us-east-1
# Required when using S3 storage: private bucket name.
# AWS_BUCKET=canabicultarr
# Required for static S3 credentials and for the bundled storage server.
# AWS_ACCESS_KEY_ID=
# Required for static S3 credentials and for the bundled storage server.
# AWS_SECRET_ACCESS_KEY=
# Optional: default false; typically true for RustFS and other S3-compatible services.
# AWS_USE_PATH_STYLE_ENDPOINT=true

# Optional bundled S3-compatible server; reuses AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY above.
# Optional: unset by default; storage enables the bundled RustFS service.
# COMPOSE_PROFILES=storage
# Optional: default 9001, bound to loopback.
S3_CONSOLE_PORT=9001

# OIDC authentication
# Generic OpenID Connect: Authentik, Authelia, Pocket ID, Keycloak, or another compatible provider.
# Optional: provider display name; leave unset to manage it in the UI.
# OIDC_PROVIDER_NAME=
# Optional: selfh.st icon identifier; leave unset to manage it in the UI.
# OIDC_PROVIDER_ICON=
# Optional: default false.
# OIDC_ENABLED=false
# Required when OIDC is enabled: exact issuer from discovery.
# OIDC_ISSUER=
# Required when OIDC is enabled.
# OIDC_CLIENT_ID=
# Required when OIDC is enabled with the supported confidential client configuration.
# OIDC_CLIENT_SECRET=
# Optional: defaults to APP_URL/api/v1/auth/oidc/callback; must match the provider callback.
# OIDC_REDIRECT_URI=http://localhost:8420/api/v1/auth/oidc/callback

# Home Assistant
# Required when connecting Home Assistant.
# HOME_ASSISTANT_URL=
# Required when connecting Home Assistant: long-lived access token.
# HOME_ASSISTANT_TOKEN=
# Optional: default true for a configured Home Assistant connection.
# HOME_ASSISTANT_SYNC_ENABLED=true
# Optional: default 60 seconds.
# HOME_ASSISTANT_SYNC_INTERVAL_SECONDS=60
# Optional: default false.
# HOME_ASSISTANT_EVENTS_ENABLED=false

# Homebridge
# Homebridge UI requires Accessory Control. Credentials refresh the API token automatically.
# Required when connecting Homebridge UI.
# HOMEBRIDGE_URL=
# Required when connecting Homebridge UI.
# HOMEBRIDGE_USERNAME=
# Required when connecting Homebridge UI; API tokens are renewed automatically.
# HOMEBRIDGE_PASSWORD=
# Optional: default true for a configured Homebridge connection.
# HOMEBRIDGE_SYNC_ENABLED=true
# Optional: default 60 seconds.
# HOMEBRIDGE_SYNC_INTERVAL_SECONDS=60
# Optional: default false.
# HOMEBRIDGE_EVENTS_ENABLED=false

# MQTT
# Optional: default false.
# MQTT_ENABLED=false
# Required when MQTT is enabled.
# MQTT_HOST=
# Optional: default 8883; set the actual broker port when different.
# MQTT_PORT=8883
# Optional: default true; must match the broker transport.
# MQTT_TLS=true
# Required only if the MQTT broker requires authentication.
# MQTT_USERNAME=
# Required only if the MQTT broker requires authentication.
# MQTT_PASSWORD=
# Optional: custom CA path inside the container; otherwise use system trust.
# MQTT_CA_FILE=

# Email delivery
# Optional: default log (no email delivery). Use smtp for activation and email notifications.
# MAIL_MAILER=log
# Port 587 negotiates STARTTLS; port 465 uses implicit TLS.
# Required for an external SMTP server; SMTP fallback is 127.0.0.1.
# MAIL_HOST=
# Optional: default 587; port 465 selects implicit TLS.
# MAIL_PORT=587
# Required only if your SMTP server requires authentication.
# MAIL_USERNAME=
# Required only if your SMTP server requires authentication.
# MAIL_PASSWORD=
# Required for real email delivery: permitted sender; placeholder fallback is hello@example.com.
# MAIL_FROM_ADDRESS=hello@example.com
# Optional: defaults to APP_NAME.
# MAIL_FROM_NAME="${APP_NAME}"

# Webhook delivery (generic, ntfy or Apprise)
# Required when webhook delivery is enabled.
# ALERT_WEBHOOK_URL=
# Explicit internal hosts, IPs or CIDRs, comma-separated; empty denies LAN access.
# Loopback, link-local and metadata addresses are always denied.
# Optional: empty by default; explicitly allow required internal destinations.
# ALERT_WEBHOOK_ALLOWED_INTERNAL=
# Required only if the receiving webhook requires a token.
# ALERT_WEBHOOK_TOKEN=
# Optional: default generic; also supports ntfy and apprise.
# ALERT_WEBHOOK_FORMAT=generic
# Optional: receiver-specific topic.
# ALERT_WEBHOOK_TOPIC=
# Optional: Apprise tag filter.
# ALERT_WEBHOOK_APPRISE_TAG=
# Required only for an Apprise receiver that needs explicit service URLs.
# ALERT_WEBHOOK_APPRISE_URLS=

# Browser push
# Required when Web Push is enabled: VAPID public key.
# WEB_PUSH_PUBLIC_KEY=
# Required when Web Push is enabled: VAPID private key.
# WEB_PUSH_PRIVATE_KEY=
# Required when Web Push is enabled: VAPID contact URI.
# WEB_PUSH_SUBJECT=
# Optional trusted HTTPS push hosts; wildcard syntax is *.domain.
# Optional: built-in trusted push-host allowlist; override only for your push service.
# WEB_PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,*.push.services.mozilla.com,web.push.apple.com,*.notify.windows.com

# Authentication defaults: password sign-in on; public registration off.
# Leave unset to manage these options in Settings > Connections > Authentication.
# Optional: default true.
# AUTH_LOCAL_ENABLED=true
# Optional: default false.
# AUTH_REGISTRATION_ENABLED=false

# Optional server Bluetooth (Linux BlueZ/D-Bus bind mount or native relay)
# Optional: default false.
BLUETOOTH_ENABLED=false
# Optional: default auto; choose bluez or relay when required by the host.
BLUETOOTH_TRANSPORT=auto
# Optional: default hci0; used by the BlueZ transport.
BLUETOOTH_ADAPTER=hci0

# Native relay for macOS/Windows (also supported on Linux). Never commit real tokens.
# Required only when using the native Bluetooth relay.
BLUETOOTH_RELAY_URL=
# Required only when using the authenticated native Bluetooth relay.
BLUETOOTH_RELAY_TOKEN=
# Optional: default false; HTTPS is required unless explicitly allowed.
BLUETOOTH_RELAY_ALLOW_HTTP=false
# Optional: custom relay CA path inside the container; otherwise use system trust.
BLUETOOTH_RELAY_CA_FILE=
