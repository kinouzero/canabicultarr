{
  "name": "canabicultarr-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "version": "python3 ../scripts/release-metadata.py --sync-compose",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test:e2e": "playwright test",
    "test:unit": "node --test tests/*.test.ts",
    "preview": "vite preview",
    "test:pwa": "node --test tests/pwa/worker.test.mjs",
    "test:pwa:e2e": "playwright test --config playwright.pwa.config.ts",
    "icons:generate": "node scripts/generate-icons.mjs",
    "build:coverage": "npm run typecheck && vite build --sourcemap --outDir dist-coverage",
    "test:unit:coverage": "node --experimental-test-coverage --test tests/*.test.ts",
    "audit": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@egjs/grid": "1.18.1",
    "@iconify-icons/lucide": "2.0.31",
    "@iconify-icons/simple-icons": "^2.0.8",
    "@iconify/vue": "^5.0.5",
    "chart.js": "4.6.1",
    "dompurify": "3.4.17",
    "marked": "18.1.3",
    "naive-ui": "2.45.3",
    "qr": "0.7.2",
    "quill": "2.0.3",
    "turndown": "7.2.5",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "monocart-coverage-reports": "3.2.1",
    "typescript": "6.0.3",
    "vite": "^8.3.6",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=26 <27"
  }
}
